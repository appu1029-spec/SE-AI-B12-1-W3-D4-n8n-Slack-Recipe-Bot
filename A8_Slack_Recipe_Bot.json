        "jsCode": "const raw = $input.item.json.text || 'Please send a valid recipe name.';\n\nconst slackText = raw\n  .replace(/^#{1,6}\\s*(.+)$/gm, '*$1*')\n  .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*')\n  .replace(/^\\s*-\\s+/gm, '• ')\n  .trim();\n\nreturn {\n  json: {\n    slackText,\n    channel: $('Edit Fields').item.json.channel\n  }\n};"
